{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "server/promptEngine",
    "outDir": "server/promptEngine/js",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": [
    "server/promptEngine/promptDNA.ts",
    "server/promptEngine/characterRegistry.ts",
    "server/promptEngine/sceneFlow.ts"
  ]
}
