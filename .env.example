#GEMINI_API_KEY=your_gemini_api_key_here

# Auth — JWT ký cookie httpOnly (bắt buộc, tối thiểu 16 ký tự); ví dụ: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret

PORT=8787
# API bind address (default 127.0.0.1 — matches Vite proxy). Use 0.0.0.0 only if you need LAN access.
# BIND_HOST=127.0.0.1

# Vbee Text-to-Speech — https://studio.vbee.vn/apps (App ID + Token). VBEE_CALLBACK_URL: HTTPS công khai khi gọi POST /api/vbee/tts (vd. ngrok).
VBEE_APP_ID=
VBEE_TOKEN=
VBEE_API_BASE=https://vbee.vn/api/v1
VBEE_CALLBACK_URL=

# User database — SQLite trong thư mục data/ (mặc định veo3pro.sqlite). Lần chạy đầu tự tạo file & bảng; có users.json cũ sẽ nhập một lần.
# USER_DB_FILE=veo3pro.sqlite

# Tuỳ chọn: thời hạn JWT (mặc định 7d), cookie ~ JWT_COOKIE_DAYS
# JWT_EXPIRES_IN=7d
# JWT_COOKIE_DAYS=7
# AUTH_COOKIE_NAME=veo3pro_auth

# Google OAuth — đăng ký / đăng nhập nhanh (tuỳ chọn). Redirect URI trong Google Console phải khớp GOOGLE_REDIRECT_URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/google/callback
# APP_ORIGIN=http://localhost:5173
# GOOGLE_AUTH_ENABLED=true

# SMTP (tuỳ chọn — OTP / email chào mừng)
# Bật khi đủ SMTP_HOST + SMTP_USER + SMTP_PASS. Tắt: SMTP_ENABLED=false
# Gmail: bật xác minh 2 bước → Mật khẩu ứng dụng 16 ký tự. SMTP_FROM chỉ tên (không có @) vẫn được — server gắn thêm SMTP_USER.
# Tuỳ chọn ép preset Gmail (thường không cần nếu SMTP_HOST=smtp.gmail.com): SMTP_SERVICE=gmail
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=your_email@gmail.com
#SMTP_PASS=your_app_password_here
#SMTP_FROM="Veo3 Pro <your_email@gmail.com>"
#SMTP_TLS_REJECT_UNAUTHORIZED=true
#SMTP_WELCOME_SUBJECT=Chào mừng đến Veo3 Pro
#SMTP_OTP_SUBJECT=Mã đăng nhập Veo3 Pro (email OTP đăng nhập)

# Job persistence: file (default) or redis
# FLOW_STORAGE=file
# FLOW_DATA_DIR=./data/flow-jobs
# FLOW_STORAGE=redis
# REDIS_URL=redis://127.0.0.1:6379

# Optional Auto Flow (comma-separated image models try in order)
# FLOW_STORYBOARD_MODEL=gemini-2.0-flash
# FLOW_PROMPT_ENHANCE_MODEL=gemini-2.0-flash
# FLOW_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation,gemini-2.0-flash-exp-image-generation

# BullMQ pipeline (set FLOW_USE_QUEUE=true + REDIS_URL; run `npm run worker` unless FLOW_RUN_WORKERS=true)
# FLOW_USE_QUEUE=false
# FLOW_RUN_WORKERS=true
# FLOW_JOB_ATTEMPTS=5
# FLOW_JOB_BACKOFF_MS=8000
# FLOW_CONCURRENCY_PROMPT=2
# FLOW_CONCURRENCY_STORYBOARD=2
# FLOW_CONCURRENCY_IMAGE=2
# FLOW_CONCURRENCY_VIDEO=1
# FLOW_CONCURRENCY_MERGE=1

# Quotas & throttle (per Flow user id via X-Flow-User-Id header; requires REDIS_URL)
# FLOW_MAX_USER_CONCURRENT=3
# FLOW_DAILY_JOBS_PER_USER=50
# FLOW_MAX_GLOBAL_ACTIVE=20

# Vision QC (Gemini multimodal; rejects blank/off-topic images during retries)
# FLOW_VISION_QC_MODEL=gemini-2.0-flash

# Observability (GET /api/flow/metrics only when true)
# FLOW_METRICS_PUBLIC=false

# Prompt Studio (text generation model)
# PROMPT_STUDIO_MODEL=gemini-2.5-flash
# Text → Video — sinh bảng «Nhân vật & Bối cảnh» (mặc định cùng model Prompt Studio)
# TEXT_VIDEO_CAST_MODEL=gemini-2.5-flash
# Text → Video — sinh tab «Phân cảnh» (@CHAR / #BACKGROUND). Mặc định = CAST model hoặc Prompt Studio
# TEXT_VIDEO_SCENES_MODEL=gemini-2.5-flash

# Gemini sampling temperature by call purpose (0–2). Omit to use defaults: topic 0.7, scene idea 0.6, final scene 0.3.
# GEMINI_TEMP_TOPIC=0.7
# GEMINI_TEMP_THESIS=0.35
# GEMINI_TEMP_SCENE_IDEA=0.6
# GEMINI_TEMP_FINAL_SCENE=0.3
# GEMINI_TEMP_SUGGESTIONS=0.75
# GEMINI_TEMP_STORYBOARD=0.45
# GEMINI_TEMP_VISION_QC=0.1

# OpenAI — module Phân tích video (hook, viral, prompt tái sử dụng). Bắt buộc để gọi /api/video-analysis/*
#OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_VIDEO_ANALYSIS_URL_MODEL=gpt-4o-mini
# OPENAI_VIDEO_ANALYSIS_FILE_MODEL=gpt-4o
# OPENAI_VIDEO_MAX_MB=32

# Ultra (Playwright + Chrome portable) — khi Chrome thoát ngay / ULTRA_LAUNCH_FAILED
# Mặc định mở cửa sổ Chrome (gemini.google) khi tạo video Ultra. Chạy nền không pop-up: ULTRA_HEADLESS=1
# ULTRA_HEADLESS=1
# Windows: mặc định thêm --no-sandbox. Tắt hành vi đó: ULTRA_DISABLE_WIN_SANDBOX_RELAX=1
# ULTRA_DISABLE_WIN_SANDBOX_RELAX=1
# ULTRA_NO_SANDBOX=1
# ULTRA_STRICT_SANDBOX=1
# Thêm cờ Chrome (phân tách bởi |): ULTRA_CHROME_EXTRA_ARGS=--disable-extensions|--disable-features=AudioServiceOutOfProcess
# Thời gian chờ tối đa một lần automation Ultra (ms). Mặc định 3600000 = 60 phút (Veo web có thể rất lâu).
# ULTRA_VEO_AUTOMATION_TIMEOUT_MS=3600000
# Ngưỡng byte tối thiểu khi bắt mp4 từ mạng/DOM/ổ đĩa (mặc định 8000): ULTRA_MIN_VIDEO_BYTES=4000
