{
  "name": "veo3pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/kill-dev-ports.mjs",
    "dev": "concurrently -k \"vite\" \"cross-env NODE_ENV=development node server/index.js\"",
    "worker": "node server/worker.js",
    "build": "npm run build:prompt-dna && vite build",
    "build:prompt-dna": "tsc -p tsconfig.prompt-dna.json",
    "preview": "vite preview",
    "prestart": "npm run build:prompt-dna",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "test:prompt-engine": "node --test server/promptEngine/promptEngine.test.mjs",
    "pack:win-portable": "powershell -ExecutionPolicy Bypass -File scripts/package-windows-portable.ps1",
    "pack:win-portable:fat": "powershell -ExecutionPolicy Bypass -File scripts/package-windows-portable.ps1 -SkipPrune",
    "pack:win-portable:folder": "powershell -ExecutionPolicy Bypass -File scripts/package-windows-portable.ps1 -SkipPrune -SkipZip"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "bullmq": "^5.47.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "openai": "^6.35.0",
    "playwright": "^1.59.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serverless-http": "^3.2.0",
    "sharp": "^0.33.5",
    "undici": "^8.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.3"
  }
}
